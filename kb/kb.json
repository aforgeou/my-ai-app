  "curriculum": {
    "CR01": {
      "code": "CR01",
      "title": "代数式",
      "domain": "数与代数",
      "pdf_page": 62,
      "print_page": 55,
      "items": [
        {
          "no": "①",
          "text": "借助现实情境了解代数式，进一步理解用字母表示数的意义。"
        },
        {
          "no": "②",
          "text": "能分析具体问题中的简单数量关系，并用代数式表示；能根据特定的问题查阅资料，找到所需的公式。"
        },
        {
          "no": "③",
          "text": "会把具体数代入代数式进行计算。"
        },
        {
          "no": "⑤",
          "text": "理解整式的概念，掌握合并同类项和去括号的法则；能进行简单的整式加减运算。"
        }
      ],
      "selection_note": "①—⑤为七年级代数式与整式加减的直接依据；⑥乘法公式、⑦因式分解属后续学段，不计入本主题范围。"
    },
    "CR02": {
      "code": "CR02",
      "title": "方程与方程组",
      "domain": "数与代数",
      "pdf_page": 63,
      "print_page": 56,
      "items": [
        {
          "no": "①",
          "text": "能根据现实情境理解方程的意义，能针对具体问题列出方程；理解方程解的意义，经历估计方程解的过程。"
        },
        {
          "no": "②",
          "text": "掌握等式的基本性质；能解一元一次方程和可化为一元一次方程的分式方程。"
        },
        {
          "no": "③",
          "text": "掌握消元法，能解二元一次方程组。"
        },
        {
          "no": "⑧",
          "text": "能根据具体问题的实际意义，检验方程解的合理性。"
        }
      ],
      "selection_note": "①—③、⑧为七年级方程与方程组的直接依据；④三元一次方程组为选学，⑤—⑦为一元二次方程，不计入本主题范围。"
    },
    "CR03": {
      "code": "CR03",
      "title": "不等式与不等式组",
      "domain": "数与代数",
      "pdf_page": 63,
      "print_page": 56,
      "items": [
        {
          "no": "①",
          "text": "结合具体问题，了解不等式的意义，探索不等式的基本性质。"
        },
        {
          "no": "②",
          "text": "能解数字系数的一元一次不等式，并能在数轴上表示出解集；会用数轴确定两个一元一次不等式组成的不等式组的解集。"
        },
        {
          "no": "③",
          "text": "能根据具体问题中的数量关系，列出一元一次不等式，解决简单的问题。"
        }
      ],
      "selection_note": "三条均为七年级不等式与不等式组的直接依据。"
    }
  },
